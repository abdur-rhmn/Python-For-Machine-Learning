        "lst = list(map(int, input().split()))\n",
        "\n",
        "even = list(filter(lambda x : x%2==0, lst))\n",
        "\n",
        "squares_of_even_num = list(map(lambda x : x**2, even))\n",
        "\n",
        "print(squares_of_even_num)"
